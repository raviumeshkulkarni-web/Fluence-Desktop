{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default-capability",
  "description": "Default permissions for Fluence windows",
  "windows": [
    "main",
    "overlay",
    "wizard"
  ],
  "permissions": [
    "core:default",
    "updater:default",
    "process:default",
    "process:allow-restart",
    "dialog:allow-open",
    "fs:allow-read",
    "fs:allow-write",
    "fs:allow-exists",
    "fs:allow-mkdir",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$APPDATA/**" },
        { "path": "$APPDATA" },
        { "path": "$APPLOCALDATA/**" },
        { "path": "$APPLOCALDATA" },
        { "path": "$APPCONFIG/**" },
        { "path": "$APPCONFIG" },
        { "path": "$TEMP/**" }
      ]
    }
  ]
}
